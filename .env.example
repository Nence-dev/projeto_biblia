# Google Gemini API Key (Obtenha gratuitamente em: https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo Gemini (Padrão: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Versão padrão da Bíblia no YouVersion (nvi, ara, naa, nvt, arc)
BIBLIA_VERSAO=nvi

# Diretório para salvar os estudos gerados em Markdown
ESTUDOS_DIR=estudos
